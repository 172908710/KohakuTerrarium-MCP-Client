# Copy to a protected deployment environment and replace the placeholders.
KT_MCP_PUBLIC_ORIGIN=https://mcp.example.test
KT_MCP_REGISTRY_DB=/var/lib/kt-mcp-provision/registry.sqlite3
KT_MCP_ROUTES_MAP=/var/lib/kt-mcp-provision/routes.map
KT_MCP_PORT_START=18766
KT_MCP_PORT_END=18865
# Comma-separated SHA-256 hashes of production endpoint secrets; never put the
# production secret itself here.
KT_MCP_RESERVED_SECRET_HASHES=
# Required absolute executable that validates and reloads the separate Nginx layer.
KT_MCP_RELOAD_HELPER=/usr/local/sbin/kt-mcp-provision-nginx-reload
# Required shared header token; do not bake it into the Windows client.
KT_MCP_PROVISION_ADMIN_TOKEN=replace-with-a-secret-from-a-secret-manager
