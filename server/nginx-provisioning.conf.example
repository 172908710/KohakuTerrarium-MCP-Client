# Nginx include for the independent MCP device routes
#
# This file is a template/documentation artifact. The registry generates
# server-context `location` blocks in the route map; it is not an http-context
# `map` directive and it must not replace the live production location.
#
# In the existing HTTPS `server { ... }` block, add this include before or
# alongside the existing production /mcp/ prefix location:
#
#     include /var/lib/kt-mcp-provision/routes.map;
#
# Keep the existing production location and its proxy_pass unchanged. For
# example, if the live configuration currently contains:
#
#     location ^~ /mcp/ {
#         proxy_pass http://127.0.0.1:18765;
#         # keep the existing MCP proxy headers and other settings here
#     }
#
# leave that location in place. The generated exact-match locations take
# precedence for registered device paths. Unknown /mcp/<path> values (and
# trailing/path variants not in the exact list) fall through to the existing
# production Bridge; verify that Bridge returns HTTP 404 for those unknown
# paths. Never add a broad fallback to an allocated device port and never
# replace the production proxy_pass.
#
# A generated entry is a complete server-context location, including the MCP
# streaming/WebSocket proxy headers:
#
#     location = /mcp/<secret> {
#         proxy_pass http://127.0.0.1:18766;
#         proxy_http_version 1.1;
#         proxy_set_header Upgrade $http_upgrade;
#         proxy_set_header Connection "upgrade";
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_read_timeout 86400;
#         proxy_buffering off;
#     }
#
# Validate the complete active configuration with `nginx -t` before reload.
